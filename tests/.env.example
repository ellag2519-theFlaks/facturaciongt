# Copy to .env and adjust if your local setup differs from the defaults.
# conftest.py reads these via os.environ; every value below is optional —
# if unset, the defaults shown here (matching the seeded dev accounts) are used.

BASE_URL=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

VENDEDOR_USERNAME=vendedor
VENDEDOR_PASSWORD=vendedor123
