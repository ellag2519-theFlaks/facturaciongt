# SDD scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Local Claude Code tooling config (dev-server launch config for the
# in-app browser preview; machine-local, not part of the project itself)
.claude/

# Node
node_modules/
npm-debug.log*

# Env files (never commit secrets/JWT_SECRET)
.env
!.env.example

# Backend data
facturacion-service/data/

# Frontend build output
frontend/dist/

# Python
tests/__pycache__/
tests/.pytest_cache/
tests/venv/
tests/.venv/

# Test run artifacts (regenerated every run)
tests/evidence/
tests/videos/
tests/reports/

# CI run artifacts from the Jenkins pipeline (regenerated every build)
facturacion-service/backend-junit.xml
facturacion-service/npm-audit.json
exchange-service/npm-audit.json
frontend/npm-audit.json
